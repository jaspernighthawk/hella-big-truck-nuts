---
// src/components/Header.astro
// ------------------------------------------------------------
// The pink banner at the top of every page.
//
// This replaces Hugo's layouts/partials/header.html. The original
// had all its styling crammed into style="..." attributes; those
// now live in src/styles/global.css under ".site-header", which
// means you can restyle the banner without touching this file.
//
// The homepage banner reads "HOME. OF. NUTS."; every other page reads
// "HELLA. BIG. TRUCK. NUTS." (Jasper's choice, carried over from Hugo).
// The text arrives as a prop so each page can decide; if nothing is
// passed, the default below is used.
// ------------------------------------------------------------
interface Props {
  text?: string;
}

const { text = 'HELLA. BIG. TRUCK. NUTS.' } = Astro.props;
---

<header class="site-header">
  <a class="nav-bounce" href="/about/">about</a>
  <a class="site-title" href="/">{text}</a>
  <a class="nav-bounce" href="/blog/">blog</a>
</header>
